---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import { getEvents, EVENT_TYPE_LABELS, type Event } from '../../lib/events';
import { formatLongDate, formatTime, formatTimeRange, formatWeekdayDate } from '../../lib/format';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

interface Props {
  event: Event;
}

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const poster = 'poster' in data ? data.poster : undefined;
const posterAlt = 'posterAlt' in data && data.posterAlt ? data.posterAlt : `Poster for ${data.title}`;
const isPast = (data.endDate ?? data.date) < new Date();
const time = data.endDate ? `${formatTime(data.date)} – ${formatTime(data.endDate)}` : formatTime(data.date);
---

<BaseLayout title={data.title} description={data.summary}>
  <article>
    <header class="border-b border-rule">
      <div class="container-page py-16 md:py-24">
        <a href="/events" class="label text-muted hover:text-ink">← All events</a>
        <p class="mt-10 label text-signal-text">
          {EVENT_TYPE_LABELS[data.type]}
          {data.tentative && <span class="ml-2 text-muted">· Tentative</span>}
          {data.draft && <span class="ml-2 text-muted">· Draft</span>}
          {isPast && <span class="ml-2 text-muted">· Past event</span>}
        </p>
        <h1 class="mt-6 max-w-4xl text-h1 text-ink">{data.title}</h1>
      </div>
    </header>

    <div class="container-page grid gap-12 py-16 md:py-20 lg:grid-cols-12 lg:gap-6">
      <aside class="lg:col-span-4" aria-label="Event details">
        {data.sessions?.length ? (
          <>
            <h2 class="label text-muted">Sessions</h2>
            <ol class="mt-3 divide-y divide-rule border-y border-rule">
              {data.sessions.map((s) => (
                <li class="py-4 text-small">
                  <time datetime={s.start.toISOString()} class="block font-medium text-ink">
                    {formatWeekdayDate(s.start)}
                  </time>
                  <span class="block text-ink">{formatTimeRange(s.start, s.end)}</span>
                  <span class="block text-muted">{s.location}</span>
                  {s.contact && (
                    <a href={`mailto:${s.contact}`} class="mt-1 inline-block text-signal-text underline underline-offset-4">
                      {s.contact}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </>
        ) : (
        <dl class="divide-y divide-rule border-y border-rule">
          <div class="grid grid-cols-3 gap-4 py-4">
            <dt class="label text-muted">Date</dt>
            <dd class="col-span-2 text-small text-ink">
              <time datetime={data.date.toISOString()}>{formatLongDate(data.date)}</time>
            </dd>
          </div>
          <div class="grid grid-cols-3 gap-4 py-4">
            <dt class="label text-muted">Time</dt>
            <dd class="col-span-2 text-small text-ink">{time}</dd>
          </div>
          <div class="grid grid-cols-3 gap-4 py-4">
            <dt class="label text-muted">Where</dt>
            <dd class="col-span-2 text-small text-ink">{data.location}</dd>
          </div>
        </dl>
        )}
        {
          !isPast && (data.rsvp || data.link) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {data.rsvp && <Button href={data.rsvp}>RSVP</Button>}
              {data.link && (
                <Button href={data.link} variant="secondary">
                  Event page
                </Button>
              )}
            </div>
          )
        }
        {
          poster && (
            <a href={poster.src} class="mt-10 block overflow-hidden rounded-sm border border-rule" title="Open full-size poster">
              <Image src={poster} alt={posterAlt} widths={[400, 800, 1086]} sizes="(min-width: 64rem) 33vw, 100vw" class="h-auto w-full" />
            </a>
          )
        }
      </aside>

      <div class="prose-dug lg:col-span-7 lg:col-start-6">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
