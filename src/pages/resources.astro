---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ResourceRow from '../components/ui/ResourceRow.astro';
import { SITE } from '../lib/site';

const visible = (entry: { data: { draft: boolean } }) => import.meta.env.DEV || !entry.data.draft;
const byOrder = <T extends { data: { order: number; title: string } }>(a: T, b: T) =>
  a.data.order - b.data.order || a.data.title.localeCompare(b.data.title);

const [guides, resources] = await Promise.all([
  getCollection('guides', visible).then((g) => g.sort(byOrder)),
  getCollection('resources', visible).then((r) => r.sort(byOrder)),
]);

// Section order. Keys match the `category` field in content files.
const CATEGORIES = [
  { key: 'concentration', title: 'The concentration' },
  { key: 'advising', title: 'Advising' },
  { key: 'courses', title: 'Courses' },
  { key: 'research', title: 'Research' },
  { key: 'reading', title: 'Reading and learning' },
] as const;

// "bulletin.brown.edu" for web links, the address for email links.
const linkLabel = (url: string) => {
  const u = new URL(url);
  return u.protocol === 'mailto:' ? u.pathname : u.hostname.replace(/^www\./, '');
};

const sections = [
  ...(guides.length > 0 ? [{ key: 'guides', title: 'Guides' }] : []),
  ...CATEGORIES,
].map((section, i) => ({ ...section, index: String(i + 1).padStart(2, '0') }));
---

<BaseLayout title="Resources" description="Declaring the concentration, advising, courses, research and reading for computational neuroscience at Brown.">
  <PageHeader label="Resources" title="Resources">
    Where to start, what to take and who to ask.
  </PageHeader>

  <div class="container-page py-16 md:py-24">
    <nav aria-label="Resource sections" class="mb-16 flex flex-wrap gap-2">
      {
        sections.map(({ key, title }) => (
          <a
            href={`#${key}`}
            class="rounded-sm border border-rule bg-surface px-3 py-1.5 text-small text-ink transition-colors hover:border-ink"
          >
            {title}
          </a>
        ))
      }
    </nav>

    <div class="space-y-16 md:space-y-20">
      {
        sections.map(({ key, title, index }) => {
          const isGuides = key === 'guides';
          const items = isGuides ? [] : resources.filter((r) => r.data.category === key);
          return (
            <section id={key} aria-labelledby={`${key}-heading`} class="grid gap-6 md:grid-cols-12">
              <div class="md:col-span-3">
                <p class="label text-signal-text">{index}</p>
                <h2 id={`${key}-heading`} class="mt-2 text-h2 text-ink">
                  {title}
                </h2>
              </div>
              <div class="md:col-span-9">
                {isGuides ? (
                  <ul class="divide-y divide-rule border-y border-rule">
                    {guides.map(({ id, data }) => (
                      <ResourceRow
                        title={data.title}
                        note={data.summary}
                        href={`/resources/${id}`}
                        meta="Guide"
                        draft={data.draft}
                        external={false}
                      />
                    ))}
                  </ul>
                ) : items.length > 0 ? (
                  <ul class="divide-y divide-rule border-y border-rule">
                    {items.map(({ data }) => (
                      <ResourceRow
                        title={data.title}
                        note={data.summary}
                        href={data.url}
                        meta={data.url ? linkLabel(data.url) : undefined}
                        draft={data.draft}
                      />
                    ))}
                  </ul>
                ) : (
                  <p class="border-y border-rule py-5 text-small text-muted">
                    Coming soon. Suggest something on the{' '}
                    <a href={SITE.ed} class="text-signal-text underline underline-offset-4">
                      Ed board
                    </a>
                    .
                  </p>
                )}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
