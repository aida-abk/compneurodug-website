---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { SITE } from '../lib/site';

const visible = (entry: { data: { draft: boolean } }) => import.meta.env.DEV || !entry.data.draft;
const byOrder = <T extends { data: { order: number; title: string } }>(a: T, b: T) =>
  a.data.order - b.data.order || a.data.title.localeCompare(b.data.title);

const [guides, resources] = await Promise.all([
  getCollection('guides', visible).then((g) => g.sort(byOrder)),
  getCollection('resources', visible).then((r) => r.sort(byOrder)),
]);

// Section order and copy. Keys match the `category` field in content files.
const CATEGORIES = [
  { key: 'concentration', title: 'The concentration', intro: 'Requirements and official pages for the ScB.' },
  { key: 'advising', title: 'Advising', intro: 'Where to ask questions, and who answers them.' },
  { key: 'courses', title: 'Courses', intro: 'Classes at Brown that build toward computational neuroscience.' },
  { key: 'research', title: 'Research', intro: 'Labs, funding and how to get a first research position.' },
  { key: 'reading', title: 'Reading and learning', intro: 'Free courses, textbooks and places to start on your own.' },
] as const;

// "bulletin.brown.edu ↗" for web links, the address for email links.
const linkLabel = (url: string) => {
  const u = new URL(url);
  return u.protocol === 'mailto:' ? u.pathname : u.hostname.replace(/^www\./, '');
};

const sectionNumber = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout title="Resources" description="Declaring the concentration, advising, courses, research and reading for computational neuroscience at Brown.">
  <PageHeader label="Resources" title="Resources">
    Where to start, what to take and who to talk to. Something missing? Tell us and we'll add it.
  </PageHeader>

  {
    guides.length > 0 && (
      <section aria-labelledby="guides-heading" class="py-20 md:py-28">
        <div class="container-page">
          <SectionHeader index="01" title="Guides" id="guides-heading">
            Step-by-step answers to the questions we get most.
          </SectionHeader>
          <ul class="mt-10 grid gap-6 md:grid-cols-2">
            {guides.map(({ id, data }) => (
              <li class="relative flex flex-col rounded-sm border border-rule bg-surface p-6 transition-colors hover:border-ink md:p-8">
                <p class="label text-signal-text">
                  Guide
                  {data.draft && <span class="ml-2 text-muted">· Draft</span>}
                </p>
                <h3 class="mt-3 font-serif text-h2 font-medium text-ink">
                  <a href={`/resources/${id}`} class="after:absolute after:inset-0">
                    {data.title}
                  </a>
                </h3>
                <p class="mt-3 flex-1 text-small text-muted">{data.summary}</p>
                <p class="mt-6 text-small font-medium text-ink">
                  Read the guide <span aria-hidden="true">→</span>
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    CATEGORIES.map(({ key, title, intro }, i) => {
      const items = resources.filter((r) => r.data.category === key);
      const n = i + (guides.length > 0 ? 1 : 0);
      return (
        <section
          aria-labelledby={`${key}-heading`}
          class:list={['py-20 md:py-28', n % 2 === 1 ? 'border-y border-rule bg-surface' : 'border-t border-rule']}
        >
          <div class="container-page">
            <SectionHeader index={sectionNumber(n)} title={title} id={`${key}-heading`}>
              {intro}
            </SectionHeader>
            {items.length > 0 ? (
              <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {items.map(({ data }) => (
                  <li class="relative flex flex-col rounded-sm border border-rule bg-field p-6 transition-colors hover:border-ink">
                    {data.draft && <p class="label text-muted">Draft</p>}
                    <h3 class="text-h3 font-medium text-ink">
                      {data.url ? (
                        <a href={data.url} class="after:absolute after:inset-0" rel="noopener">
                          {data.title}
                        </a>
                      ) : (
                        data.title
                      )}
                    </h3>
                    <p class="mt-3 flex-1 text-small text-muted">{data.summary}</p>
                    {data.url && (
                      <p class="mt-6 label break-all text-signal-text">
                        {linkLabel(data.url)} <span aria-hidden="true">↗</span>
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-10 text-small text-muted">
                Coming soon. Suggestions welcome on the{' '}
                <a href={SITE.ed} class="text-signal-text underline underline-offset-4">
                  Ed advising board
                </a>
                .
              </p>
            )}
          </div>
        </section>
      );
    })
  }
</BaseLayout>
