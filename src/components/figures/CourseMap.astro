---
// Course map for the Computational Neuroscience Sc.B., from src/lib/course-map.ts.
// Stages read left to right on large screens and top to bottom on small ones.
// Each requirement is a native <details>: no JavaScript, keyboard accessible.
import { BULLETIN_YEAR, CHECKED, STAGES, TOTAL_COURSES, courseUrl, stageCourseCount } from '../../lib/course-map';
import { formatDateOnly } from '../../lib/format';
import { SITE } from '../../lib/site';

const counted = STAGES.reduce((n, s) => n + stageCourseCount(s), 0);
if (counted !== TOTAL_COURSES) {
  console.warn(`[course-map] Stages add up to ${counted} courses, expected ${TOTAL_COURSES}.`);
}
---

<div class="course-map">
  <ol class="grid gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1.2fr_auto_0.8fr] lg:gap-3">
    {
      STAGES.map((stage, i) => (
        <>
          {i > 0 && (
            <li class="flex justify-center text-muted lg:pt-1" aria-hidden="true">
              <span class="font-mono text-h3 lg:hidden">↓</span>
              <span class="hidden font-mono text-h3 lg:inline">→</span>
            </li>
          )}
          <li>
            <h3 class="flex items-baseline justify-between gap-3 border-b border-structure pb-2">
              <span class="label text-signal-text">
                {String(i + 1).padStart(2, '0')} · {stage.title}
              </span>
              <span class="label text-muted">
                {stageCourseCount(stage)} {stageCourseCount(stage) === 1 ? 'course' : 'courses'}
              </span>
            </h3>
            <ul class="mt-3 space-y-2">
              {stage.requirements.map((req) => {
                const single = req.options.length === 1;
                return (
                  <li>
                    <details class="group rounded-sm border border-rule bg-surface open:border-structure">
                      <summary class="flex cursor-pointer list-none items-start justify-between gap-3 px-4 py-3">
                        <span>
                          <span class="block text-small font-medium text-ink">{req.title}</span>
                          <span class="mt-0.5 block font-mono text-label text-muted">
                            {single ? req.options[0].code : `${req.options.length} options`}
                          </span>
                        </span>
                        <span class="flex shrink-0 items-center gap-2">
                          {req.take > 1 && (
                            <span class="rounded-sm bg-structure px-1.5 py-0.5 font-mono text-label text-field">
                              ×{req.take}
                            </span>
                          )}
                          <span class="font-mono text-body text-muted group-open:hidden" aria-hidden="true">
                            +
                          </span>
                          <span class="hidden font-mono text-body text-muted group-open:inline" aria-hidden="true">
                            −
                          </span>
                        </span>
                      </summary>
                      <div class="border-t border-rule px-4 pt-2 pb-4">
                        <p class="label text-muted">{req.take === 1 ? 'Take one' : `Take ${req.take}`}</p>
                        <ul class="mt-2 space-y-2">
                          {req.options.map((course) => (
                            <li class="text-small">
                              <a
                                href={courseUrl(course.code)}
                                class="font-mono text-label text-signal-text underline decoration-rule underline-offset-4 hover:decoration-signal-text"
                                rel="noopener"
                              >
                                {course.code}
                              </a>
                              <span class="block text-ink">{course.title}</span>
                              {course.note && <span class="block text-muted">{course.note}</span>}
                            </li>
                          ))}
                        </ul>
                        {req.footnote && <p class="mt-3 text-small text-muted">{req.footnote}</p>}
                      </div>
                    </details>
                  </li>
                );
              })}
            </ul>
          </li>
        </>
      ))
    }
  </ol>

  <p class="mt-8 flex flex-wrap gap-x-4 gap-y-1 border-t border-rule pt-4 text-small text-muted">
    <span>{TOTAL_COURSES} courses for the Sc.B.</span>
    <span aria-hidden="true">·</span>
    <span>Checked against the {BULLETIN_YEAR} Bulletin on {formatDateOnly(new Date(CHECKED))}.</span>
    <a href={SITE.concentration.bulletin} class="text-signal-text underline underline-offset-4" rel="noopener">
      The Bulletin and your advisor have the final word ↗
    </a>
    <a href="https://cab.brown.edu" class="text-signal-text underline underline-offset-4" rel="noopener">
      This semester's schedule on Courses@Brown ↗
    </a>
  </p>
</div>

<style>
  /* Hide the default disclosure triangle in Safari. */
  .course-map summary::-webkit-details-marker {
    display: none;
  }
</style>
