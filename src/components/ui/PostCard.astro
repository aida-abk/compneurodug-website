---
import type { NewsletterPost } from '../../lib/substack';
import { formatLongDate } from '../../lib/format';

interface Props {
  post: NewsletterPost;
}

const { post } = Astro.props;
---

<article class="group relative overflow-hidden rounded-sm border border-rule bg-field transition-colors hover:border-ink">
  {
    post.image && (
      <img
        src={post.image}
        alt=""
        width="1344"
        height="256"
        loading="lazy"
        decoding="async"
        class="aspect-banner w-full border-b border-rule object-cover"
      />
    )
  }
  <div class="p-6 md:p-8">
    <p class="label text-signal-text">
      <time datetime={post.date.toISOString()}>{formatLongDate(post.date)}</time>
    </p>
    <h3 class="mt-3 font-serif text-h2 font-medium text-ink">
      <a href={post.url} class="after:absolute after:inset-0" rel="noopener">
        {post.title}
      </a>
    </h3>
    {post.summary && <p class="mt-2 text-small text-muted">{post.summary}</p>}
    <p class="mt-6 text-small font-medium text-ink">
      Read on Substack <span aria-hidden="true">↗</span>
    </p>
  </div>
</article>
