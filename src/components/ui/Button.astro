---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2 rounded-sm border px-5 py-3 text-small font-medium transition-colors',
    variant === 'primary' && 'border-signal bg-signal text-ink hover:border-signal-display hover:bg-signal-display',
    variant === 'secondary' && 'border-rule bg-surface text-ink hover:border-ink',
    className,
  ]}
  rel={isExternal ? 'noopener' : undefined}
>
  <slot />
  <span aria-hidden="true">{isExternal ? '↗' : '→'}</span>
</a>
