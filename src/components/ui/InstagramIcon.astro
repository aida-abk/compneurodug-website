---
// Simple outline glyph for links to the DUG Instagram. Decorative: the link
// around it carries the accessible name.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 24 24" class={className} aria-hidden="true" focusable="false">
  <g class="fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.3" cy="6.7" r="0.6" class="fill-current" />
  </g>
</svg>
