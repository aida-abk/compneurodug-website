---
// Section header in the brand-board style: coral index label, serif title,
// optional intro on the right. Renders the section's h2.
interface Props {
  index: string;
  title: string;
  id: string;
}

const { index, title, id } = Astro.props;
---

<div class="grid gap-6 border-b border-rule pb-10 md:grid-cols-12 md:items-end">
  <div class="md:col-span-7">
    <p class="label text-signal-text">{index}</p>
    <h2 id={id} class="mt-3 text-h1 text-ink">{title}</h2>
  </div>
  {
    Astro.slots.has('default') && (
      <div class="text-body text-muted md:col-span-5">
        <slot />
      </div>
    )
  }
</div>
