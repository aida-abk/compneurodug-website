---
import Button from '../ui/Button.astro';
import HeroArt from '../hero/HeroArt.astro';
import { SITE } from '../../lib/site';
---

<section aria-labelledby="hero-heading" class="border-b border-rule">
  <div class="container-page grid items-center gap-12 py-16 md:py-24 lg:grid-cols-12 lg:gap-6 lg:py-28">
    <div class="lg:col-span-7">
      <p class="label text-signal-text">Departmental Undergraduate Group · {SITE.university}</p>
      <h1 id="hero-heading" class="mt-6 text-display text-ink">Computational Neuroscience</h1>
      <p class="mt-8 max-w-xl text-body text-muted">
        Undergraduates at Brown who want to understand the brain by modelling it. We read papers, host researchers,
        and help each other find a way into the field.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="#events">Upcoming events</Button>
        <Button href={SITE.substack.subscribe} variant="secondary">Get the newsletter</Button>
      </div>
    </div>
    <div class="mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none" data-hero-art>
      <HeroArt />
    </div>
  </div>
</section>
