---
import Button from '../ui/Button.astro';
import HeroArt from '../hero/HeroArt.astro';
import { SITE } from '../../lib/site';
---

<section aria-labelledby="hero-heading" class="border-b border-rule">
  <div class="container-page grid items-center gap-12 py-16 md:py-24 lg:grid-cols-12 lg:gap-6 lg:py-28">
    <div class="lg:col-span-7">
      <p class="label text-signal-text">Departmental Undergraduate Group · {SITE.university}</p>
      <h1 id="hero-heading" class="mt-6 text-display text-ink">Computational Neuroscience</h1>
      <p class="mt-8 max-w-xl text-body text-muted">
        Undergraduates at Brown who want to understand the brain by modelling it. We read papers, host researchers,
        and help each other find a way into the field.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="#events">Upcoming events</Button>
        <Button href={SITE.substack.subscribe} variant="secondary">Get the newsletter</Button>
      </div>
    </div>
    <div class="relative mx-auto aspect-square w-full max-w-md lg:col-span-5 lg:max-w-none" data-hero-art>
      <div class="hero-fallback">
        <HeroArt />
      </div>
      <!-- 3D layer: hero-gate.ts mounts it on capable desktops only. -->
      <div class="absolute inset-0" data-hero-stage aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../hero/hero-gate';

  const art = document.querySelector<HTMLElement>('[data-hero-art]');
  const stage = art?.querySelector<HTMLElement>('[data-hero-stage]');
  if (art && stage) initHero(art, stage);
</script>

<style>
  .hero-fallback {
    transition: opacity var(--dug-duration-slow) var(--dug-ease-out);
  }
  [data-hero-art][data-live] .hero-fallback {
    opacity: 0;
  }
</style>
