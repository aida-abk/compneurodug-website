---
import SectionHeader from '../ui/SectionHeader.astro';
import Figure from '../figures/Figure.astro';
import BrainMap, { type RegionId } from '../figures/BrainMap.astro';
import { SITE } from '../../lib/site';

// Each DUG function mapped onto a brain region whose job is the metaphor.
// Numbers match the callouts in BrainMap.astro. DRAFT COPY — Aida to review.
const REGIONS: {
  id: RegionId;
  n: number;
  title: string;
  region: string;
  body: string;
  link?: { href: string; label: string };
}[] = [
  {
    id: 'auditory',
    n: 1,
    title: 'Advising',
    region: 'Auditory cortex',
    body: 'Peer advice on courses and the concentration.',
    link: { href: SITE.mentoringForm, label: 'Join the mentoring program' },
  },
  {
    id: 'arcuate',
    n: 2,
    title: 'Connecting with faculty',
    region: 'Arcuate fasciculus',
    body: 'Talks and intros to Brown and Carney researchers.',
  },
  {
    id: 'tpj',
    n: 3,
    title: 'Building community',
    region: 'Temporoparietal junction',
    body: 'Socials, study groups and good company.',
  },
  {
    id: 'visual',
    n: 4,
    title: 'Flavours of comp neuro',
    region: 'Visual cortex',
    body: 'Theory, data, ML, cognition, neuroengineering.',
  },
];
---

<section aria-labelledby="what-heading" class="brain-map border-t border-rule bg-surface py-20 md:py-28">
  <div class="container-page">
    <SectionHeader index="02 · What we do" title="A map of what we do" id="what-heading" />

    <div class="grid gap-12 pt-12 md:pt-16 lg:grid-cols-12 lg:items-center lg:gap-6">
      <Figure number={1} caption="Left hemisphere, lateral view, annotated" class="lg:col-span-8">
        <BrainMap />
      </Figure>

      <ol class="grid gap-x-6 sm:grid-cols-2 lg:col-span-4 lg:grid-cols-1">
        {
          REGIONS.map(({ id, n, title, region, body, link }) => (
            <li data-item={id} class="brain-item flex gap-4 border-t border-rule py-6">
              <span class="brain-item-number inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-ink font-mono text-label text-ink transition-colors">
                {n}
              </span>
              <div>
                <h3 class="text-h3 font-medium text-ink">{title}</h3>
                <p class="mt-1 label text-signal-text">{region}</p>
                <p class="mt-3 text-small text-muted">{body}</p>
                {link && (
                  <a
                    href={link.href}
                    class="mt-2 inline-block text-small text-signal-text underline decoration-rule underline-offset-4 hover:decoration-signal-text"
                    rel="noopener"
                  >
                    {link.label} ↗
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Regions rest as a faint tint and light up when their card is hovered.
     Pure CSS via :has(), no JavaScript. Phase 5 also lights them on scroll. */
  .brain-map :global(.brain-region) {
    opacity: 0.18;
    transition: opacity var(--dug-duration-base) var(--dug-ease-out);
  }
  .brain-map :global(.brain-callout-marker) {
    transition: fill var(--dug-duration-base) var(--dug-ease-out);
  }

  .brain-map:has([data-item='auditory']:hover) :global([data-region='auditory']),
  .brain-map:has([data-item='arcuate']:hover) :global([data-region='arcuate']),
  .brain-map:has([data-item='tpj']:hover) :global([data-region='tpj']),
  .brain-map:has([data-item='visual']:hover) :global([data-region='visual']) {
    opacity: 0.9;
  }

  .brain-map:has([data-item='auditory']:hover) :global([data-callout='auditory'] .brain-callout-marker),
  .brain-map:has([data-item='arcuate']:hover) :global([data-callout='arcuate'] .brain-callout-marker),
  .brain-map:has([data-item='tpj']:hover) :global([data-callout='tpj'] .brain-callout-marker),
  .brain-map:has([data-item='visual']:hover) :global([data-callout='visual'] .brain-callout-marker) {
    fill: var(--dug-signal);
  }

  .brain-item:hover .brain-item-number {
    background-color: var(--dug-signal);
    border-color: var(--dug-signal);
  }
</style>
