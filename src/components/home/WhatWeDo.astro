---
import SectionHeader from '../ui/SectionHeader.astro';
import Figure from '../figures/Figure.astro';
import BrainLateral from '../figures/BrainLateral.astro';
import PyramidalNeuron from '../figures/PyramidalNeuron.astro';

// DRAFT COPY — Aida to review.
const pillars = [
  {
    title: 'Journal club',
    body: 'One paper a week, read together and picked apart. Pizza included.',
    icon: 'M4 6h7v13H4zM13 6h7v13h-7z',
  },
  {
    title: 'Speaker series',
    body: 'Brown and Carney researchers on their work and how they got there.',
    icon: 'M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3zM6 11a6 6 0 0 0 12 0M12 17v4',
  },
  {
    title: 'Research',
    body: 'Finding a lab, reaching out to PIs and starting your first project.',
    icon: 'M4 19h16M6 16l4-5 3 3 5-7',
  },
  {
    title: 'Community',
    body: 'Socials, study sessions and advice on courses from people a year ahead.',
    icon: 'M6 7a2 2 0 1 0 0 .01M18 7a2 2 0 1 0 0 .01M12 18a2 2 0 1 0 0 .01M7.5 8.5l3.5 8M16.5 8.5l-3.5 8M8 7h8',
  },
];
---

<section aria-labelledby="what-heading" class="border-t border-rule bg-surface py-20 md:py-28">
  <div class="container-page">
    <SectionHeader index="02 · What we do" title="From neurons to networks" id="what-heading">
      We meet weekly during term. Everything is open to any Brown undergraduate.
    </SectionHeader>

    <div class="grid gap-12 py-12 md:grid-cols-2 md:gap-6 md:py-16">
      <Figure number={1} caption="Left hemisphere, lateral view">
        <BrainLateral />
      </Figure>
      <Figure number={2} caption="Pyramidal neuron, cortex layer 5">
        <PyramidalNeuron />
      </Figure>
    </div>

    <ul class="grid gap-10 border-t border-rule pt-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        pillars.map(({ title, body, icon }) => (
          <li>
            <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false">
              <path
                d={icon}
                class="fill-none stroke-structure"
                stroke-width="1.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <h3 class="mt-5 label text-ink">{title}</h3>
            <p class="mt-3 text-small text-muted">{body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
