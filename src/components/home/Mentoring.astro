---
import Button from '../ui/Button.astro';
import { SITE } from '../../lib/site';
---

<section aria-labelledby="mentoring-heading" class="container-page py-16 md:py-20">
  <div class="grid gap-8 rounded-sm border border-rule bg-surface p-8 md:grid-cols-12 md:items-center md:gap-6 md:p-12">
    <div class="md:col-span-7">
      <p class="label text-signal-text">Mentoring program</p>
      <h2 id="mentoring-heading" class="mt-3 text-h2 text-ink">Find a mentor, or be one.</h2>
      <p class="mt-3 max-w-2xl text-body text-muted">
        Connect underclassmen with upperclassmen to discuss concentration-related questions, coursework, research,
        and career paths.
      </p>
    </div>
    <div class="md:col-span-5 md:justify-self-end">
      <Button href={SITE.mentoringForm} class="lg:whitespace-nowrap">Sign up as a mentor or mentee</Button>
    </div>
  </div>
</section>
