---
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import { getLatestPosts } from '../../lib/substack';
import { formatLongDate } from '../../lib/format';
import { SITE } from '../../lib/site';

const posts = await getLatestPosts(3);
---

<section aria-labelledby="newsletter-heading" class="border-t border-rule bg-surface py-20 md:py-28">
  <div class="container-page">
    <SectionHeader index="04 · Newsletter" title="From the newsletter" id="newsletter-heading">
      Papers we're reading, people we've met and what's coming up. Published on Substack.
    </SectionHeader>

    <div class="mt-12 grid gap-6 lg:grid-cols-12">
      <ul class="grid gap-6 lg:col-span-8">
        {
          posts.map((post) => (
            <li class="group relative overflow-hidden rounded-sm border border-rule bg-field transition-colors hover:border-ink">
              {post.image && (
                <img
                  src={post.image}
                  alt=""
                  width="1344"
                  height="256"
                  loading="lazy"
                  decoding="async"
                  class="aspect-banner w-full border-b border-rule object-cover"
                />
              )}
              <div class="p-6 md:p-8">
                <p class="label text-signal-text">
                  <time datetime={post.date.toISOString()}>{formatLongDate(post.date)}</time>
                </p>
                <h3 class="mt-3 font-serif text-h2 font-medium text-ink">
                  <a href={post.url} class="after:absolute after:inset-0" rel="noopener">
                    {post.title}
                  </a>
                </h3>
                {post.summary && <p class="mt-2 text-small text-muted">{post.summary}</p>}
                <p class="mt-6 text-small font-medium text-ink">
                  Read on Substack <span aria-hidden="true">↗</span>
                </p>
              </div>
            </li>
          ))
        }
        {
          posts.length === 0 && (
            <li class="rounded-sm border border-rule bg-field p-8">
              <p class="text-small text-muted">
                Read every issue on{' '}
                <a href={SITE.substack.home} class="text-signal-text underline underline-offset-4">
                  Substack
                </a>
                .
              </p>
            </li>
          )
        }
      </ul>

      <aside class="flex flex-col justify-between rounded-sm border border-rule bg-field p-6 md:p-8 lg:col-span-4" aria-labelledby="subscribe-heading">
        <div>
          <p class="label text-signal-text">Subscribe</p>
          <h3 id="subscribe-heading" class="mt-3 font-serif text-h2 font-medium text-ink">One email, a few times a term.</h3>
          <p class="mt-3 text-small text-muted">Events, papers and opportunities in computational neuroscience at Brown.</p>
        </div>
        <div class="mt-8">
          <Button href={SITE.substack.subscribe}>Subscribe on Substack</Button>
        </div>
      </aside>
    </div>
  </div>
</section>
