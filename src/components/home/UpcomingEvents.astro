---
import SectionHeader from '../ui/SectionHeader.astro';
import EventList from '../ui/EventList.astro';
import EventsEmpty from '../ui/EventsEmpty.astro';
import { getUpcomingEvents } from '../../lib/events';

const events = await getUpcomingEvents(4);
---

<section id="events" aria-labelledby="events-heading" class="container-page py-20 md:py-28">
  <SectionHeader index="03 · Events" title="Upcoming events" id="events-heading">
    <a href="/events" class="text-signal-text underline decoration-rule underline-offset-4 hover:decoration-signal-text">
      All events →
    </a>
  </SectionHeader>

  {events.length > 0 ? <EventList events={events} /> : <EventsEmpty />}
</section>
